  <voice name="Isabel"><prosody rate="100%" pitch="+4st" volume="-0.92dB">Mommy mommy I want this! </prosody></voice>
  <voice name="Mother"><prosody rate="100%" pitch="-1st" volume="-0.92dB">Isabel [sigh] [sigh] this is not for you</prosody></voice>
  <voice name="Mother"><prosody rate="100%" pitch="-1st" volume="-0.92dB">Put it down please !</prosody></voice>
  <break time="500ms"/>
  <voice name="Isabel"><prosody rate="100%" pitch="+4st" volume="-0.92dB"> But, I [sigh] !</prosody></voice>
  <break time="600ms"/>
  <voice name="Isabel"><prosody rate="100%" pitch="+4st" volume="-0.92dB"> I [sigh] ! </prosody></voice>
  <break time="400ms"/>
  <voice name="Isabel"><prosody rate="100%" pitch="+4st" volume="-0.92dB"> But I, I really really want it. I spotted it first ! </prosody></voice>
  <break time="400ms"/>
  <voice name="Mother"><prosody rate="100%" pitch="-1st" volume="-0.92dB">No, put it down right now.</prosody></voice>
  <voice name="Mother"><prosody rate="100%" pitch="-1st" volume="-0.92dB"> This is the end of this discussion !!!</prosody></voice>
</speak>
